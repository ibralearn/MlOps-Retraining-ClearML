FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "clearml>=1.16" \
    clearml-agent \
    torch \
    torchvision \
    pillow \
    tqdm \
    python-dotenv

ENTRYPOINT ["clearml-agent"]
